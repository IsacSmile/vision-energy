generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model ServiceEnquiry {
  id            String   @id @default(uuid())
  reference     String   @unique
  serviceSlug   String
  serviceTitle  String
  name          String
  company       String?
  phone         String
  email         String
  emirate       String
  projectType   String
  preferredDate String?
  message       String
  sourceUrl     String
  status        String   @default("NEW")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductEnquiry {
  id               String   @id @default(uuid())
  reference        String   @unique
  categoryCode     String
  categoryTitle    String
  name             String
  company          String?
  phone            String
  email            String
  quantity         String?
  deliveryLocation String?
  message          String
  sourceUrl        String
  status           String   @default("NEW")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Service {
  id             String        @id @default(uuid())
  slug           String        @unique
  title          String
  summary        String
  icon           String        @default("zap")
  metaChips      String[]
  content        Json
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([slug])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([publishedAt])
}

model ProductCategory {
  id              String        @id @default(uuid())
  code            String        @unique
  slug            String        @unique
  group           String
  groupLabel      String
  sortOrder       Int           @default(0)
  priority        Boolean       @default(false)
  title           String
  description     String
  productFamilies String[]
  image           String?
  imageAlt        String?
  status          ContentStatus @default(DRAFT)
  reviewNote      String?
  seoTitle        String?
  seoDescription  String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([slug])
  @@index([sortOrder])
  @@index([deletedAt])
}

enum PostStatus {
  PUBLISHED
  DRAFT
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  subheading  String
  content     String     @db.Text
  coverImage  String?
  coverAlt    String?
  bodyImage   String?
  bodyAlt     String?
  category    String
  status      PostStatus @default(PUBLISHED)
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
}

model SlugRedirect {
  id        String   @id @default(uuid())
  entity    String   // SERVICE | PRODUCT | POST
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromPath])
}

model AuditLog {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  actor     String
  action    String   // CREATE | UPDATE | DELETE | RESTORE | PUBLISH | UNPUBLISH | LOGIN | LOGOUT
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([at])
  @@index([actor])
  @@index([action])
  @@index([entity])
}

enum ProductStatus {
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String         @id @default(cuid())
  code             String         @unique
  title            String
  description      String         @db.Text
  includes         String[]
  category         String
  subcategoryGroup String
  sortOrder        Int            @default(0)
  status           ProductStatus  @default(PUBLISHED)
  imageUrl         String?
  imageAlt         String?
  isPlaceholder    Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([category, subcategoryGroup, sortOrder])
}



