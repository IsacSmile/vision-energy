# Environment Variables Template
# Copy this file to .env for local development

# Database connection (SQLite for local dev, Postgres compatible)
DATABASE_URL="file:./dev.db"

# Admin credentials
ADMIN_EMAIL="admin@visionenergyme.com"
# Generated via bcrypt with salt rounds 10. Example below is for password: Admin@Vision2026!
ADMIN_PASSWORD_HASH="$2b$10$M7s..l3utzhcA28N8hy2seQ25r981w5yOsd3NZTpYLTUSI./HdIga"

# Session JWT Secret
JWT_SECRET="vision-energy-super-secret-jwt-key-2026-change-this"

# Optional SMTP Email Configuration (Application safely works if unconfigured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vision Energy System <noreply@visionenergyme.com>"
NOTIFICATION_EMAIL="info@visionenergyme.com"
